{
  "name": "civic-inquiry",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "反直覺知識測驗與公共議題自主探索平台（V0.2 最小互動版）",
  "scripts": {
    "dev": "npm run content && vite",
    "build": "npm run content && tsc --noEmit && vite build && node scripts/make-single.mjs",
    "preview": "vite preview",
    "content": "tsx scripts/publish-content.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "api": "tsx server/index.ts",
    "build:static": "node scripts/build-static.mjs",
    "test:perf": "playwright test --config=perf.playwright.config.ts",
    "build:pwa": "node scripts/build-pwa.mjs",
    "withdraw": "tsx scripts/withdraw.ts",
    "build:single": "npm run content && tsc --noEmit && vite build && node scripts/make-single.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsdom": "^30.1.3",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
